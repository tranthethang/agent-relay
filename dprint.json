{
  "markdown": {
    "textWrap": "maintain"
  },
  "yaml": {},
  "typescript": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "excludes": [
    "**/.agent-relay/**",
    "**/.tmp-test/**",
    "**/node_modules/**",
    "**/dist/**"
  ],
  "plugins": [
    "npm:@dprint/markdown@0.24.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/typescript@0.96.1"
  ]
}

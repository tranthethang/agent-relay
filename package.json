{
  "name": "@tranthethang/agent-relay",
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranthethang/agent-relay.git"
  },
  "bin": {
    "atry": "dist/atry.js"
  },
  "files": [
    "dist/atry.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "check": "dprint check \"**/*.ts\" && tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node --experimental-strip-types scripts/maint/coverage-report.ts",
    "tokens": "node --experimental-strip-types scripts/maint/skill-tokens.ts",
    "sync": "node --experimental-strip-types scripts/maint/sync-references.ts",
    "sync:check": "node --experimental-strip-types scripts/maint/sync-references.ts --check"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}

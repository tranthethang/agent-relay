# agent-relay working files created inside a target project when testing
# locally (not relevant when this repo is cloned standalone, but harmless
# to keep here as documentation of the convention)
.agent-relay/

# TypeScript bundle
dist/

node_modules/

# Temporary git repos created by vitest
.tmp-test/

# macOS Finder metadata (any depth; pattern without slash matches nested paths)
.DS_Store
**/.DS_Store
.archify/
.vitest/
coverage/

# SonarScanner working directory
.scannerwork/
